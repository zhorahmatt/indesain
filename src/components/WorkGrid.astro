---
import ProjectCard from './ProjectCard.astro';
import SectionHead from './SectionHead.astro';
import { getLang, getProjects, localizePath, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const projects = await getProjects(lang);
const featured = projects.slice(0, 6);
---

<section class="work section">
  <SectionHead title={t.work.selected} count={projects.length} link={{ label: t.work.all, href: localizePath('/work', lang) }} />
  <div class="layout wrap grid">
    {featured.map((project, i) => <ProjectCard project={project} class={`slot slot-${i + 1}`} />)}
  </div>
</section>

<style>
  .layout {
    row-gap: clamp(64px, 9vw, 140px);
    align-items: start;
    grid-auto-flow: dense;
  }

  /* Alternating rhythm: wide + narrow, narrow + wide, centred feature. */
  .layout :global(.slot-1) { grid-column: 1 / span 7; }
  .layout :global(.slot-2) { grid-column: 9 / span 4; margin-top: 30%; }
  .layout :global(.slot-3) { grid-column: 2 / span 4; }
  .layout :global(.slot-4) { grid-column: 7 / span 6; margin-top: 18%; }
  .layout :global(.slot-5) { grid-column: 5 / span 8; }
  .layout :global(.slot-6) { grid-column: 1 / span 3; margin-top: 40%; }

  @media (max-width: 809px) {
    .layout :global(.slot) {
      grid-column: 1 / -1 !important;
      margin-top: 0 !important;
    }
  }
</style>
