---
// Answers stay in the HTML (closed <details>), so search engines and AI assistants can read them.
// The same entries feed the FAQPage structured data on the homepage.
import { faqItems, getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const items = faqItems(lang);
---

<section class="faq section wrap">
  <div class="grid">
    <p class="label faq-label">{t.faq.label}</p>
    <h2 class="serif statement faq-title" data-reveal="lines">{t.faq.title}</h2>
  </div>

  <div class="items" data-reveal="fade" data-stagger>
    {
      items.map((item) => (
        <div class="item grid">
          <details>
            <summary class="serif h3">
              <h3>{item.q}</h3>
              <span class="sign" aria-hidden="true" />
            </summary>
            <p class="answer">{item.a}</p>
          </details>
        </div>
      ))
    }
  </div>
</section>

<style>
  .faq-label {
    grid-column: 1 / span 3;
    padding-top: 0.6em;
  }

  .faq-title {
    grid-column: 4 / span 9;
  }

  .items {
    margin-top: clamp(64px, 8vw, 120px);
    border-bottom: 1px solid var(--line);
  }

  .item {
    border-top: 1px solid var(--line);
  }

  details {
    grid-column: 4 / span 9;
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-block: 24px;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font: inherit;
  }

  .sign {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease, ease);
  }

  .sign::after {
    transform: rotate(90deg);
  }

  [open] .sign::after {
    transform: rotate(0deg);
  }

  .answer {
    max-width: 60ch;
    padding-bottom: 32px;
    color: var(--mute);
  }

  @media (max-width: 809px) {
    .faq-label,
    .faq-title,
    details {
      grid-column: 1 / -1;
    }

    .faq-label {
      margin-bottom: 24px;
    }
  }
</style>

<script>
  import { ScrollTrigger } from '../scripts/motion';

  // Opening an answer changes the page height; re-measure the pinned and scroll-linked sections below.
  document.querySelectorAll('.faq details').forEach((item) => item.addEventListener('toggle', () => ScrollTrigger.refresh()));
</script>
