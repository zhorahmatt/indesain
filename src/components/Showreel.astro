---
import Media from './Media.astro';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  src?: string;
}

const { src } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="reel" data-reel>
  <div class="reel-sticky">
    <div class="reel-frame" data-reel-frame>
      <Media src={src} video label="Showreel, 16:9" alt={t.showreel.alt} class="fill" />
      <p class="reel-caption serif h2" data-reel-caption>{t.showreel.caption}</p>
    </div>
  </div>
</section>

<style>
  .reel {
    height: 220vh;
    background: var(--paper);
  }

  .reel-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .reel-frame {
    position: relative;
    width: 100%;
    height: 100%;
    clip-path: inset(22% 30% round 4px);
    color: #fff;
  }

  .reel-frame :global(.fill) {
    position: absolute;
    inset: 0;
  }

  .reel-frame :global(.placeholder) {
    background: linear-gradient(200deg, #4a4843, #23221f);
    color: rgb(255 255 255 / 0.4);
  }

  .reel-caption {
    position: absolute;
    left: var(--gutter);
    bottom: 32px;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .reel {
      height: auto;
    }

    .reel-sticky {
      position: static;
    }

    .reel-frame {
      clip-path: none;
    }

    .reel-caption {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  const reel = document.querySelector('[data-reel]');
  if (reel && !reduceMotion) {
    gsap
      .timeline({ scrollTrigger: { trigger: reel, start: 'top top', end: 'bottom bottom', scrub: true } })
      .to('[data-reel-frame]', { clipPath: 'inset(0% 0% round 0px)', ease: 'none', duration: 1 })
      .to('[data-reel-caption]', { opacity: 1, duration: 0.2 }, 0.8);
  }
</script>
