---
import Media from './Media.astro';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  src?: string;
}

const { src } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<!-- Full-screen studio video, shown as is (no scroll effect). -->
<section class="reel">
  <Media src={src} video label="Showreel, 16:9" alt={t.showreel.alt} class="fill" />
  <p class="reel-caption serif h2">{t.showreel.caption}</p>
</section>

<style>
  .reel {
    position: relative;
    height: 100vh;
    min-height: 480px;
    overflow: hidden;
    color: #fff;
  }

  .reel :global(.fill) {
    position: absolute;
    inset: 0;
  }

  .reel :global(.placeholder) {
    background: linear-gradient(200deg, #4a4843, #23221f);
    color: rgb(255 255 255 / 0.4);
  }

  .reel-caption {
    position: absolute;
    left: var(--gutter);
    bottom: 32px;
  }
</style>
