---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { getLang, openingHours, useTranslations } from '../i18n/utils';
import { studioId } from '../lib/seo';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const hours = openingHours(lang);
---

<Base
  title={t.seo.contact.title}
  description={t.seo.contact.description}
  pageType="ContactPage"
  breadcrumbs={[{ name: t.nav.contact, path: '/contact' }]}
  mainEntity={studioId(Astro.site!)}
  cta={false}>
  <PageHeader label={t.contact.label} title={t.contact.title} />

  <section class="contact wrap grid">
    <div class="details small">
      <div>
        <p class="mute">{t.contact.email}</p>
        <a href={`mailto:${site.email}`} class="serif h3 link-underline">{site.email}</a>
      </div>
      <div>
        <p class="mute">{t.contact.phone}</p>
        <a href={site.phoneHref} class="link-underline">{site.phone}</a>
      </div>
      <div>
        <p class="mute">{t.contact.studio}</p>
        <address>{site.address.map((line) => <span>{line}</span>)}</address>
        <a href={site.maps.link} class="link-underline" target="_blank" rel="noopener">{t.contact.directions}</a>
      </div>
      <div>
        <p class="mute">{t.contact.hours}</p>
        <dl class="hours">
          {
            hours.map((row) => (
              <div>
                <dt>{row.days}</dt>
                <dd>{row.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Point `action` at your form backend (Formspree, Netlify Forms, an API route…). -->
    <form class="form" method="post" action="#" data-reveal="fade" data-stagger>
      <label>
        <span class="small mute">{t.contact.form.name}</span>
        <input name="name" required autocomplete="name" />
      </label>
      <label>
        <span class="small mute">{t.contact.form.email}</span>
        <input name="email" type="email" required autocomplete="email" />
      </label>
      <label>
        <span class="small mute">{t.contact.form.type}</span>
        <select name="type">
          {t.contact.form.types.map((type) => <option>{type}</option>)}
        </select>
      </label>
      <label>
        <span class="small mute">{t.contact.form.message}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit" class="submit">{t.contact.form.submit}</button>
    </form>
  </section>

  <section class="map wrap" data-reveal="media">
    <iframe
      src={site.maps.embed}
      title={t.contact.mapTitle}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </section>
</Base>

<style>
  .contact {
    padding-bottom: clamp(64px, 8vw, 120px);
    row-gap: 64px;
  }

  .details {
    grid-column: 1 / span 4;
    display: grid;
    align-content: start;
    gap: 32px;
  }

  .details div {
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  address {
    display: grid;
    font-style: normal;
  }

  .hours {
    display: grid;
    gap: 4px;
    width: 100%;
    max-width: 280px;
  }

  .details .hours div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .hours dd {
    margin: 0;
  }

  .map {
    padding-bottom: var(--section);
  }

  .map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 360px;
    border: 0;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s;
  }

  .map iframe:hover {
    filter: none;
  }

  .form {
    grid-column: 6 / span 7;
    display: grid;
    gap: 28px;
  }

  label {
    display: grid;
    gap: 8px;
  }

  input,
  select,
  textarea {
    font: inherit;
    font-size: 18px;
    color: inherit;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    padding: 8px 0;
    outline: none;
    transition: border-color 0.3s;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--ink);
  }

  textarea {
    resize: vertical;
  }

  .submit {
    justify-self: start;
    padding: 14px 24px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    transition: opacity 0.3s;
  }

  .submit:hover {
    opacity: 0.8;
  }

  @media (max-width: 809px) {
    .details,
    .form {
      grid-column: 1 / -1;
    }
  }
</style>
