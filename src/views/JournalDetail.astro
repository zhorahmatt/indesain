---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';

import { getLang, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const { title, category, date, excerpt, cover } = post.data;
const { Content } = await render(post);
const formatted = date.toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={title} description={excerpt}>
  <article>
    <header class="head wrap grid">
      <p class="small mute meta">{formatted} · {category}</p>
      <h1 class="serif statement title" data-reveal="lines" data-trigger="load" data-delay="0.1">{title}</h1>
      <p class="h3 serif mute excerpt" data-reveal="fade" data-delay="0.4">{excerpt}</p>
    </header>

    <div class="wrap" data-reveal="media">
      <Media src={cover} alt={title} label="Article cover · 16:9" ratio="16 / 9" parallax eager />
    </div>

    <div class="body section wrap grid">
      <a href={localizePath('/journal', lang)} class="small back link-underline">{t.journal.back}</a>
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(140px, 18vw, 220px);
    padding-bottom: 64px;
    row-gap: 24px;
  }

  .meta,
  .title,
  .excerpt {
    grid-column: 3 / span 8;
  }

  .back {
    grid-column: 1 / span 2;
    align-self: start;
    justify-self: start;
  }

  .prose {
    grid-column: 3 / span 7;
    font-size: 19px;
    line-height: 1.6;
    display: grid;
    gap: 1.1em;
  }

  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--fs-h3);
    letter-spacing: -0.025em;
    margin-top: 1em;
  }

  @media (max-width: 809px) {
    .meta,
    .title,
    .excerpt,
    .back,
    .prose {
      grid-column: 1 / -1;
    }

    .back {
      margin-bottom: 32px;
    }
  }
</style>
