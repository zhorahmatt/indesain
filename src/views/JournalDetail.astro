---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';

import { getLang, localizePath, slugOf, useTranslations } from '../i18n/utils';
import { inLanguage, shareImage, studioId } from '../lib/seo';

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const { title, category, date, excerpt, cover } = post.data;
const { Content } = await render(post);
const formatted = date.toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });

const path = `/journal/${slugOf(post)}`;
const url = new URL(localizePath(path, lang), Astro.site).href;
const article = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  url,
  headline: title,
  description: excerpt,
  articleSection: category,
  image: shareImage(cover, Astro.site!),
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: { '@id': studioId(Astro.site!) },
  publisher: { '@id': studioId(Astro.site!) },
  inLanguage: inLanguage(lang),
  mainEntityOfPage: { '@id': `${url}#webpage` },
};
---

<Base
  title={`${title} · indesain`}
  description={excerpt}
  image={cover}
  published={date}
  pageType="WebPage"
  breadcrumbs={[
    { name: t.nav.journal, path: '/journal' },
    { name: title, path },
  ]}
  schema={[article]}
  mainEntity={article['@id']}>
  <article>
    <header class="head wrap grid">
      <p class="small mute meta"><time datetime={date.toISOString().slice(0, 10)}>{formatted}</time> · {category}</p>
      <h1 class="serif statement title" data-reveal="lines" data-trigger="load" data-delay="0.1">{title}</h1>
      <p class="h3 serif mute excerpt" data-reveal="fade" data-delay="0.4">{excerpt}</p>
    </header>

    <div class="wrap" data-reveal="media">
      <Media src={cover} alt={title} label="Article cover · 16:9" ratio="16 / 9" parallax eager />
    </div>

    <div class="body section wrap grid">
      <a href={localizePath('/journal', lang)} class="small back link-underline">{t.journal.back}</a>
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(140px, 18vw, 220px);
    padding-bottom: 64px;
    row-gap: 24px;
  }

  .meta,
  .title,
  .excerpt {
    grid-column: 3 / span 8;
  }

  .back {
    grid-column: 1 / span 2;
    align-self: start;
    justify-self: start;
  }

  .prose {
    grid-column: 3 / span 7;
    font-size: 19px;
    line-height: 1.6;
    display: grid;
    gap: 1.1em;
  }

  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--fs-h3);
    letter-spacing: -0.025em;
    margin-top: 1em;
  }

  @media (max-width: 809px) {
    .meta,
    .title,
    .excerpt,
    .back,
    .prose {
      grid-column: 1 / -1;
    }

    .back {
      margin-bottom: 32px;
    }
  }
</style>
