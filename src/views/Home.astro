---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Process from '../components/Process.astro';
import Showreel from '../components/Showreel.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import JournalRow from '../components/JournalRow.astro';
import Faq from '../components/Faq.astro';
import { faqItems, getLang, localizePath } from '../i18n/utils';
import { faqNode } from '../lib/seo';

const lang = getLang(Astro.currentLocale);
const faq = faqNode(new URL(localizePath('/', lang), Astro.site).href, faqItems(lang));
---

<Base schema={[faq]}>
  <Hero />
  <Intro />
  <WorkGrid />
  <Process />
  <Showreel src="https://videos.pexels.com/video-files/17211936/17211936-hd_1920_1080_30fps.mp4" />
  <Services />
  <Testimonials />
  <Faq />
  <JournalRow />
</Base>
