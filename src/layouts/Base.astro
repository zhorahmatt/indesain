---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CursorTrail from '../components/CursorTrail.astro';
import ContactCta from '../components/ContactCta.astro';
import { site } from '../data/site';
import { defaultLang, getLang, langs, localizePath, unlocalizePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Show the "Start a project" section above the footer. */
  cta?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description = t.description, cta = true } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${t.tagline}`;
const path = unlocalizePath(Astro.url.pathname);

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.legalName,
  alternateName: site.name,
  foundingDate: String(site.founded),
  description: t.description,
  url: new URL(localizePath('/', lang), Astro.site).href,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.postal.street,
    addressLocality: site.postal.locality,
    addressRegion: site.postal.region,
    postalCode: site.postal.code,
    addressCountry: site.postal.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.maps.link,
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days.map((d) => ({ Mo: 'Monday', Tu: 'Tuesday', We: 'Wednesday', Th: 'Thursday', Fr: 'Friday', Sa: 'Saturday' })[d]),
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: site.social.map((s) => s.href),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!--
      Language detection. Only Indonesian (default) pages redirect, so an /en/ link always stays English.
      A saved choice (from the switcher) wins; otherwise the browser's first language decides once and is saved.
      Indonesian and regional languages stay on Indonesian; anything else goes to English. Crawlers are never redirected.
    -->
    <script is:inline>
      (function () {
        var KEY = 'indesain-lang';
        var path = location.pathname;
        if (path === '/en' || path.indexOf('/en/') === 0) return;
        if (navigator.webdriver || /bot|crawl|spider|slurp|preview|lighthouse/i.test(navigator.userAgent)) return;
        var pref = null;
        try {
          pref = localStorage.getItem(KEY);
        } catch (e) {}
        if (!pref) {
          var first = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase().split('-')[0];
          var local = ['id', 'jv', 'su', 'ms', 'ban', 'bug', 'mak', 'min'];
          pref = !first || local.indexOf(first) > -1 ? 'id' : 'en';
          try {
            localStorage.setItem(KEY, pref);
          } catch (e) {}
        }
        if (pref === 'en') location.replace('/en' + path + location.search + location.hash);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_GB'} />
    {langs.map((code) => <link rel="alternate" hreflang={code} href={new URL(localizePath(path, code), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, defaultLang), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Nav />
    <!-- Content layer sits above the pinned footer and scrolls off to reveal it. -->
    <div class="page">
      <main>
        <slot />
      </main>
      {cta && <ContactCta />}
    </div>
    <Footer />
    <CursorTrail fixed />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();

      // Remember a language picked from the switcher so detection never overrides it.
      document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) =>
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('indesain-lang', link.dataset.setLang ?? '');
          } catch {}
        }),
      );
    </script>
  </body>
</html>
