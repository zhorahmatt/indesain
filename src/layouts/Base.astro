---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CursorTrail from '../components/CursorTrail.astro';
import ContactCta from '../components/ContactCta.astro';
import { site } from '../data/site';
import { defaultLang, getLang, langs, localizePath, pagePath, useTranslations } from '../i18n/utils';
import { breadcrumbNode, inLanguage, shareImage, studioId, studioNode, websiteId, websiteNode } from '../lib/seo';

interface Props {
  /** Full <title>; defaults to the homepage title. */
  title?: string;
  description?: string;
  /** Share image (a /public path or an Unsplash URL); defaults to site.shareImage. */
  image?: string;
  /** schema.org type of this page, e.g. AboutPage, ContactPage, CollectionPage. */
  pageType?: string;
  /** Breadcrumb trail after Home, as unlocalized paths, e.g. [{ name: 'Karya', path: '/work' }]. */
  breadcrumbs?: { name: string; path: string }[];
  /** Extra schema.org nodes describing what this page is about. */
  schema?: Record<string, unknown>[];
  /** @id of the node this page is mainly about. */
  mainEntity?: string;
  /** Publish date; marks the page as an article for social previews. */
  published?: Date;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** Show the "Start a project" section above the footer. */
  cta?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  title = t.seo.home.title,
  description = t.seo.home.description,
  image,
  pageType = 'WebPage',
  breadcrumbs = [],
  schema = [],
  mainEntity,
  published,
  noindex = false,
  cta = true,
} = Astro.props;

const base = Astro.site!;
const path = pagePath(Astro.url.pathname);
const url = new URL(localizePath(path, lang), base).href;
const alternates = langs.map((code) => ({ code, href: new URL(localizePath(path, code), base).href }));
const ogImage = shareImage(image, base);
const ogLocale = { id: 'id_ID', en: 'en_GB' };

const trail = [{ name: t.nav.home, path: '/' }, ...breadcrumbs].map((item) => ({
  name: item.name,
  url: new URL(localizePath(item.path, lang), base).href,
}));

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    studioNode(lang, base),
    websiteNode(lang, base),
    {
      '@type': pageType,
      '@id': `${url}#webpage`,
      url,
      name: title,
      description,
      inLanguage: inLanguage(lang),
      isPartOf: { '@id': websiteId(base) },
      about: { '@id': studioId(base) },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
      ...(trail.length > 1 && { breadcrumb: { '@id': `${url}#breadcrumb` } }),
      ...(mainEntity && { mainEntity: { '@id': mainEntity } }),
    },
    ...(trail.length > 1 ? [breadcrumbNode(url, trail)] : []),
    ...schema,
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!--
      Language detection. Only Indonesian (default) pages redirect, so an /en/ link always stays English.
      A saved choice (from the switcher) wins; otherwise the browser's first language decides once and is saved.
      Indonesian and regional languages stay on Indonesian; anything else goes to English. Crawlers are never redirected.
    -->
    <script is:inline>
      (function () {
        var KEY = 'indesain-lang';
        var path = location.pathname;
        if (path === '/en' || path.indexOf('/en/') === 0) return;
        if (navigator.webdriver || /bot|crawl|spider|slurp|preview|lighthouse|headless|-user|fetch/i.test(navigator.userAgent)) return;
        var pref = null;
        try {
          pref = localStorage.getItem(KEY);
        } catch (e) {}
        if (!pref) {
          var first = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase().split('-')[0];
          var local = ['id', 'jv', 'su', 'ms', 'ban', 'bug', 'mak', 'min'];
          pref = !first || local.indexOf(first) > -1 ? 'id' : 'en';
          try {
            localStorage.setItem(KEY, pref);
          } catch (e) {}
        }
        if (pref === 'en') location.replace('/en' + path + location.search + location.hash);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
          <link rel="canonical" href={url} />
          {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
          <link rel="alternate" hreflang="x-default" href={alternates.find((alt) => alt.code === defaultLang)!.href} />
        </>
      )
    }

    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    {ogImage.includes('images.unsplash.com') && <meta property="og:image:width" content="1200" />}
    {ogImage.includes('images.unsplash.com') && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={ogLocale[code]} />)}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Local search: where the studio is. -->
    <meta name="geo.region" content="ID-SN" />
    <meta name="geo.placename" content={site.city} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <meta name="theme-color" content="#141413" />
    <!-- Google shows the favicon in search results; it wants a square icon in multiples of 48px. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Nav />
    <!-- Content layer sits above the pinned footer and scrolls off to reveal it. -->
    <div class="page">
      <main>
        <slot />
      </main>
      {cta && <ContactCta />}
    </div>
    <Footer />
    <CursorTrail fixed />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();

      // Remember a language picked from the switcher so detection never overrides it.
      document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) =>
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('indesain-lang', link.dataset.setLang ?? '');
          } catch {}
        }),
      );
    </script>
  </body>
</html>
